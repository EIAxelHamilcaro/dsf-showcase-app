{
  "name": "dsf-showcase-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "clean": "turbo clean && rm -rf node_modules",
    "dev": "./scripts/local.sh next dev --turbopack",
